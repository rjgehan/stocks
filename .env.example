# stocks production environment (ARCHITECTURE §23.3, §24; docs/deploy.md).
#
# Copy to `.env` in the data root on the server (/DATA/AppData/stocks/.env), then `chmod 600 .env`. Compose reads
# it through links next to the compose file: /DATA/AppData/stocks/compose/.env (the pipeline's project directory)
# and /var/lib/casaos/apps/stocks/.env (a CasaOS Import). deploy/scripts/init-host.sh does all of that and
# generates the secrets below.
#
# Rules:
#   - Keep EVERY key, even when the value is the default: CasaOS Import drops the defaults written in
#     docker-compose.yml, so this file is the only source of values there.
#   - No `$`, quotes or spaces in secrets (Compose interpolates `$` in .env values). Hex/base64 values are safe.
#   - Never commit the real `.env` (it is gitignored).
#   - Local development does not need this file (`make dev` runs H2 + simulated market data).

# ---------------------------------------------------------------- image (Compose only; no host port is published)
# Lowercase image repository, without tag (the release workflow pushes ghcr.io/<owner>/stocks).
STOCKS_IMAGE=ghcr.io/rjgehan/stocks
# Tag to run. The deploy job rewrites this line on every deploy and rollback (sha-<7 hex>, X.Y.Z or latest;
# a git tag vX.Y.Z publishes the image tags X.Y.Z and X.Y).
STOCKS_TAG=latest

# ---------------------------------------------------------------- required in production
# Public https URL served by your Cloudflare Tunnel (invite links, WebSocket origin check, MCP origin check).
APP_PUBLIC_URL=https://stocks.example.com
# Its host name alone (Compose only: the CasaOS dashboard tile opens https://<this>/). init-host.sh --url sets both.
APP_PUBLIC_HOST=stocks.example.com
# Postgres password, used by db, app and backup:  openssl rand -hex 24
DB_PASSWORD=
# 32+ random bytes, base64:  openssl rand -base64 48   (changing it invalidates every API key)
API_KEY_PEPPER=
# Secret seed for latency jitter:  openssl rand -hex 32
ENGINE_SEED=

# ---------------------------------------------------------------- first boot only
# Creates the human admin if no admin exists. Clear both values once you can log in.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------- league
# Seeds league.defaultStartingCash once; the admin UI wins afterwards.
STARTING_CASH_DEFAULT=500.00

# ---------------------------------------------------------------- market data
# hybrid = Alpaca Basic (free) + Finnhub free; alpaca-sip = the paid SIP plan.
MARKETDATA_PROFILE=hybrid
# Until you have Alpaca keys: MARKETDATA_PROFILE=simulated and MARKETDATA_ALLOW_SIMULATED_IN_PROD=true
# (prices are simulated, not real). Switch back to hybrid + false once ALPACA_KEY_ID/SECRET are set.
MARKETDATA_ALLOW_SIMULATED_IN_PROD=false
# Alpaca PAPER account keys. Use a different Alpaca account from development (one stream per key, error 406).
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# iex (free) or sip (after the 99 USD/month SIP upgrade, together with MARKETDATA_PROFILE=alpaca-sip)
ALPACA_FEED=iex
# Finnhub free key (recommended: fundamentals, ETF types, SIP last-trade stream)
FINNHUB_TOKEN=

# ---------------------------------------------------------------- proxy and JVM
# Regex of proxy addresses whose X-Forwarded-Proto / CF-Connecting-IP headers are trusted (Tomcat
# internal-proxies, §24.3). The default covers loopback, the Docker bridges and private LANs. It is safe because no
# host port is published: only containers on the stocks-edge network (the cloudflared sidecar) reach the app.
# Never leave it empty.
TRUSTED_PROXIES='127\.\d+\.\d+\.\d+|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|172\.(1[6-9]|2[0-9]|3[0-1])\.\d+\.\d+|0:0:0:0:0:0:0:1|::1'
# Extra JVM flags applied after the image's JAVA_TOOL_OPTIONS baseline (e.g. -XX:MaxRAMPercentage=60).
JDK_JAVA_OPTIONS=

# ---------------------------------------------------------------- backups (backup service)
BACKUP_KEEP_DAYS=14
# Daily pg_dump time, HH:MM UTC (05:00 UTC = 01:00 EDT / 00:00 EST, after the 20:20 ET snapshots)
BACKUP_TIME_UTC=05:00

# ---------------------------------------------------------------- agent runner (Phase 1; compose profile "agents")
# Read only by the agent-runner service (§20.5, docs/agents.md §2.5). A bot whose LLM key, stocks key or model is
# empty is skipped (logged), so the runner can be started before the keys exist.
# LLM provider keys (console.anthropic.com, platform.openai.com):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# The two AI players' stk_... keys, issued once by the admin (Admin > Players > Add player > AI bot > Create bot):
STOCKS_CLAUDE_KEY=
STOCKS_CHATGPT_KEY=
# Model ids, the owner's choice (e.g. claude-opus-5-5, gpt-5.5). A model without a built-in price needs AGENT_PRICE_*.
CLAUDE_MODEL=
OPENAI_MODEL=
# Run times (ET, on trading days: the open, midday, 10 minutes before the close), per-run caps and the per-bot daily
# LLM budget in USD. Each bot may also book up to AGENT_EXTRA_RUNS_PER_DAY extra runs a day for itself (schedule_run;
# 0 turns that off); they spend the same daily budget.
AGENT_SCHEDULE_ET=09:30,12:45,15:50
AGENT_DAILY_USD_CAP=1.00
AGENT_MAX_TOOL_CALLS=40
AGENT_MAX_RUN_SECONDS=300
AGENT_EXTRA_RUNS_PER_DAY=4
# Optional price overrides in USD per 1M tokens for the bot's model (empty = the runner's built-in table), e.g.
# input=4,output=20,cached_input=0.20,cache_write=5,cache_write_1h=8 (input and output required)
AGENT_PRICE_CLAUDE=
AGENT_PRICE_CHATGPT=
# Phase 2 (optional): run reports to the app with each bot's own key (Admin -> Bots). Default: on, to STOCKS_MCP_URL's
# host at /api/v1/agent-runs (http://app:8080/api/v1/agent-runs in compose). false turns them off; a URL overrides it.
AGENT_REPORT_RUNS=true
AGENT_REPORT_URL=

# ---------------------------------------------------------------- Phase 2: OAuth for the claude.ai / ChatGPT connectors
# Optional and NOT needed: the access-token signing key is generated on first boot and stored encrypted in the
# database under API_KEY_PEPPER (ARCHITECTURE §17.9.4). To use your own RSA key (PKCS#8 or PKCS#1 PEM, >= 2048 bits)
# set its path here AND add a read-only bind mount plus this variable to the app service in docker-compose.yml.
# OAUTH_JWK_PEM_FILE=
# Web Push needs nothing here: the VAPID key pair is generated on first boot and kept in the database. To reuse an
# existing pair instead (base64url, as `npx web-push generate-vapid-keys` prints it), pass both halves to the app, e.g.
# JDK_JAVA_OPTIONS=-Dstocks.push.vapid.public-key=B... -Dstocks.push.vapid.private-key=...

# ---------------------------------------------------------------- Cloudflare Tunnel (sidecar)
# Token of this app's own tunnel (Zero Trust > Networks > Tunnels > Create > Cloudflared; copy the token from the
# install command). Public hostname: stocks.<your-domain> -> HTTP -> stocks-app:8080. Leave empty only if you route
# to the app from a cloudflared that runs elsewhere (then stop the stocks-cloudflared container).
CLOUDFLARE_TUNNEL_TOKEN=
