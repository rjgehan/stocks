{
  "openapi": "3.1.0",
  "info": {
    "description": "Multiplayer paper-trading league. Decimals are strings; every response field is present (null when unused); errors are RFC 9457 problems with a stable `code`. Authenticate with `Authorization: Bearer stk_…` (bots, scripts) or the browser session cookie plus the X-XSRF-TOKEN header.",
    "title": "stocks API",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin"
    }
  ],
  "security": [
    {
      "apiKey": []
    },
    {
      "session": []
    }
  ],
  "tags": [
    {
      "description": "Browser session login (§17.3)",
      "name": "auth"
    },
    {
      "description": "The player's notifications",
      "name": "notifications"
    },
    {
      "description": "The authenticated player",
      "name": "me"
    },
    {
      "description": "The league rulebook (bots read this first)",
      "name": "rules"
    }
  ],
  "paths": {
    "/api/v1/auth/csrf": {
      "get": {
        "description": "Sets the XSRF-TOKEN cookie. Send its raw value as X-XSRF-TOKEN on every unsafe request.",
        "operationId": "getCsrf",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error: an RFC 9457 problem with a stable `code` (§6.5, §7.2)"
          }
        },
        "security": [],
        "summary": "Issue the XSRF-TOKEN cookie",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Humans only. Starts a session (stocks_sid cookie), rotates XSRF-TOKEN and returns Me. Errors: BAD_CREDENTIALS, LOGIN_LOCKED, PLAYER_DISABLED.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error: an RFC 9457 problem with a stable `code` (§6.5, §7.2)"
          }
        },
        "security": [],
        "summary": "Log in with handle and password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Session only. Invalidates the session and rotates XSRF-TOKEN.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error: an RFC 9457 problem with a stable `code` (§6.5, §7.2)"
          }
        },
        "summary": "End the session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "description": "Session or API key. authMethod and scopes describe this request's credentials.",
        "operationId": "getMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error: an RFC 9457 problem with a stable `code` (§6.5, §7.2)"
          }
        },
        "summary": "The authenticated player",
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/me/notifications": {
      "get": {
        "description": "Newest first. unreadOnly keeps unread ones; page with the opaque nextCursor (§6.6).",
        "operationId": "list",
        "parameters": [
          {
            "description": "Only unread notifications",
            "in": "query",
            "name": "unreadOnly",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "description": "Opaque cursor from a previous page",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "1-200, default 50",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageNotification"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error: an RFC 9457 problem with a stable `code` (§6.5, §7.2)"
          }
        },
        "summary": "List notifications",
        "tags": [
          "notifications"
        ]
      }
    },
    "/api/v1/me/notifications/read": {
      "post": {
        "description": "Exactly one of ids (up to 200 notification ids) and all=true. Ids that are not yours or already read are ignored.",
        "operationId": "markRead",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarkNotificationsReadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error: an RFC 9457 problem with a stable `code` (§6.5, §7.2)"
          }
        },
        "summary": "Mark notifications read",
        "tags": [
          "notifications"
        ]
      }
    },
    "/api/v1/rules": {
      "get": {
        "description": "Account, session, order, execution, fee, rate-limit, leaderboard and fairness rules as configured now. version changes whenever a rule changes; docs/rules.md explains them for people.",
        "operationId": "rules",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Rules"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error: an RFC 9457 problem with a stable `code` (§6.5, §7.2)"
          }
        },
        "summary": "The rulebook",
        "tags": [
          "rules"
        ]
      }
    }
  },
